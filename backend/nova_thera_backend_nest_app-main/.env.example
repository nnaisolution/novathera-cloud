PORT=4000
APP_NAME=Nova Thera

# Dedicated Postgres DB (do not share public schema with nova_thera_next)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_thera_nest?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:3001,novathera://,https://folders-drop-lou-largest.trycloudflare.com,https://deutsch-disciplinary-downloadable-transaction.trycloudflare.com,https://static-coding-guidelines-general.trycloudflare.com
BETTER_AUTH_ADMIN_APP_URL=http://localhost:3001

# Verifies the 120s hand-off token minted by the patient API (Next.js, port
# 3000) at POST /api/mobile/session-exchange. Must be byte-identical to
# MOBILE_LINK_SECRET in ../.env or every exchange fails signature validation.
MOBILE_LINK_SECRET=

# Defaults to true; set to false only for local debugging
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=true

RESEND_API_KEY=
RESEND_FROM_EMAIL=Nova Thera <marketing@novathera.ca>
# Local dev fallback (only delivers to your Resend account email):
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_TEST_RECIPIENT=you@example.com

# Enable behind reverse proxy (nginx, load balancer, etc.)
BETTER_AUTH_TRUSTED_PROXY_HEADERS=false
# BETTER_AUTH_IP_ADDRESS_HEADERS=cf-connecting-ip,x-forwarded-for

# Social providers (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/apple
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/facebook

# Stripe (Canada / CAD — test mode for local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to false locally until Tax head office is configured in Stripe test settings
STRIPE_AUTOMATIC_TAX=false
STRIPE_SUCCESS_URL_BOOKING=http://localhost:3000/book/confirmation?session_id={CHECKOUT_SESSION_ID}
STRIPE_SUCCESS_URL_SHOP=http://localhost:3000/shop/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL_SHOP=http://localhost:3000/shop/cart

# Membership (Stripe subscription plugin) — Price IDs for the Essential/Enhanced/Elite
# plans (create these as recurring monthly Prices in the Stripe Dashboard/test mode).
STRIPE_PRICE_ID_ESSENTIAL=
STRIPE_PRICE_ID_ENHANCED=
STRIPE_PRICE_ID_ELITE=
STRIPE_SUCCESS_URL_MEMBERSHIP=http://localhost:3000/account/membership?subscribed=true
STRIPE_CANCEL_URL_MEMBERSHIP=http://localhost:3000/account/membership
STRIPE_PORTAL_RETURN_URL_MEMBERSHIP=http://localhost:3000/account/membership
# Local webhook forwarding:
# stripe listen --forward-to localhost:4000/api/auth/stripe/webhook
#
# Local wipe + seed (recommended — Nest API must be running):
#   pnpm db:seed
# Creates localadmin@novathera.com / admin@123, then seeds locations/services/
# employees/products/shipping. Same script: cd ../nova_thera_admin_next_app && pnpm seed
#
# Promote an existing user to admin only:
#   ADMIN_EMAIL=you@example.com pnpm admin:create
#
# Local E2E checklist (Stripe test mode):
# 1. Nest :4000, public :3000, admin :3001; Stripe CLI listening as above
# 2. Sign up → verify email → browse /shop → cart → checkout (4242…)
# 3. Confirm order email + /account/orders; admin fulfill/ship → tracking email
# 4. Booking pay via Stripe; password reset; customer cannot open admin APIs
# 5. Refund in Stripe Dashboard → order REFUNDED + inventory restocked
# Schema: prefer `pnpm prisma db push` locally (data is disposable); migrate files cover fresh DBs.

# Google Cloud Storage — product images (public bucket) and customer documents
# (private bucket, signed URLs only).
#
# GCP_SERVICE_ACCOUNT_KEY must be the service-account JSON *base64-encoded*:
#   base64 -w0 key.json      (Linux)
#   certutil -encode ...     (Windows, then strip the header/footer)
# Raw JSON does not survive a .env file — the private key's newlines get
# mangled and parsing fails. Leave blank to fall back to
# GOOGLE_APPLICATION_CREDENTIALS or the host's attached identity.
GCP_PROJECT_ID=nova-thera
GCS_DOCUMENTS_BUCKET=nova-thera-documents
GCS_PRODUCT_IMAGES_BUCKET=nova-thera-product-images
GCP_SERVICE_ACCOUNT_KEY=
GCS_UPLOAD_URL_TTL=600
GCS_DOWNLOAD_URL_TTL=300

# Open admin self-registration on the admin app's /register page.
#
# WARNING: while this is true (the default), ANYONE who can reach the admin
# app's /register URL can create a full admin account and read every customer's
# assessments, lab results and consent forms. Set to false to disable it —
# the endpoint then refuses and the page redirects to login. Existing admins can
# still create staff from the Staff page either way.
ADMIN_SELF_SIGNUP_ENABLED=true

# Cross-subdomain session cookie. Set to the parent domain in production
# (e.g. ".novathera.ca", note the leading dot) so the API, storefront and admin
# app share one first-party session cookie. Leave blank for localhost.
AUTH_COOKIE_DOMAIN=

# Proxy hops in front of the API. 1 for a plain Cloud Run service; increase by
# one per additional proxy (external load balancer, Cloud Armor). Without this
# the per-IP rate limiters collapse into one shared bucket and audit entries
# record the load balancer's address instead of the caller's.
TRUSTED_PROXY_HOPS=1

# Optional remote push. Booking create sends only when at least one of these is
# set *and* the patient has registered an Expo push token from a native build.
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=
