# NestJS platform API (Better Auth + tRPC). Client appends /trpc.
NEXT_PUBLIC_API_URL=http://localhost:4000

# This storefront origin (Next default :3000 — conflicts with the patient API).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe.js (publishable). Leave blank to disable client-side Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Waitlist / contact emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nova Thera <marketing@novathera.ca>
# Local Resend test mode (only delivers to your Resend account email):
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_TEST_RECIPIENT=you@example.com
WAITLIST_ADMIN_EMAILS=marketing@novathera.ca
CONTACT_ADMIN_EMAILS=marketing@novathera.ca
