APP_ENV=development

# Next.js patient API (OTP, health, profile, consent).
EXPO_PUBLIC_API_URL=http://localhost:3000

# NestJS platform API (bookings, membership, family members, documents).
EXPO_PUBLIC_NEST_API_URL=http://localhost:4000

# A physical device cannot reach the host machine's localhost. Point both URLs at
# the dev machine's LAN address instead, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# EXPO_PUBLIC_NEST_API_URL=http://192.168.1.20:4000
