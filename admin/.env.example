NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Patient health observations live on the Next.js patient API (not Nest).
# The Health Data page calls this origin through a same-origin BFF.
NEXT_PUBLIC_PATIENT_API_URL=http://localhost:3000
# Server-only staff token — must match HEALTH_STAFF_API_KEY on the patient API.
PATIENT_API_STAFF_TOKEN=

# Optional — enables product image uploads via Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Local wipe + seed (pnpm seed) — Nest API must be running
# Fixed defaults (override only if you need different credentials):
# SEED_EMAIL=localadmin@novathera.com
# SEED_PASSWORD=admin@123
# SEED_LOCATIONS=2
# SEED_SERVICES=5
# SEED_EMPLOYEES=3
# SEED_PRODUCTS=6
