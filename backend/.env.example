# PostgreSQL — dedicated DB (do not share public schema with Nest)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_thera_next?schema=public"

APP_ENV=development
API_BASE_URL=http://localhost:3000

# 32-byte hex keys (openssl rand -hex 32). ENCRYPTION_KEY must be 64 hex chars.
ENCRYPTION_KEY=
PHONE_HASH_PEPPER=
OTP_PEPPER=
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=

# Signs the 120s hand-off token the mobile app exchanges at the Nest platform
# API (POST /api/mobile/session-exchange). Must match MOBILE_LINK_SECRET there.
MOBILE_LINK_SECRET=

# Optional development-only OTP bypass (never enable in staging/prod).
# When true, or when NODE_ENV is not production, SMS is skipped and code 000000 works.
OTP_DEV_BYPASS=false

CALCOM_WEBHOOK_SECRET=
CALCOM_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=

SMS_PROVIDER=stub
CRM_PROVIDER=stub

ALLOWED_ORIGINS=http://localhost:8081,novathera://

# Shared secret for admin/staff reads of health.staffList. Must match
# PATIENT_API_STAFF_TOKEN on the admin app. Leave empty to disable staff list.
HEALTH_STAFF_API_KEY=
