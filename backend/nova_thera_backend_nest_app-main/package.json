{
  "name": "nova_thera_nest_app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "auth:generate": "auth generate --config src/authentication/auth.ts -y",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:wipe": "ts-node scripts/wipe-database.ts",
    "verify:brand-split": "ts-node scripts/verify-brand-split.ts",
    "stripe:reset-links": "ts-node scripts/reset-stripe-links.ts",
    "admin:create": "ts-node scripts/create-admin.ts",
    "db:seed": "pnpm --dir ../nova_thera_admin_next_app seed",
    "db:seed:demo": "npx tsx prisma/seed-demo.ts",
    "db:seed:admin": "npx tsx prisma/seed-admin.ts",
    "db:seed:history": "ts-node scripts/seed-history.ts",
    "trpc:types": "nest build && ts-node scripts/bundle-trpc-types.ts",
    "permissions:sync": "ts-node scripts/sync-permissions.ts",
    "trpc:sync": "pnpm trpc:types && pnpm permissions:sync && ts-node scripts/copy-trpc-types.ts",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "dependencies": {
    "@better-auth/stripe": "^1.6.23",
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@thallesp/nestjs-better-auth": "^2.6.1",
    "@trpc/server": "^11.17.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
